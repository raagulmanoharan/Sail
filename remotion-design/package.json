{
  "name": "sail-remotion-design",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx --browser-executable=/usr/bin/chromium",
    "check": "tsc --noEmit",
    "compositions": "remotion compositions src/index.tsx --browser-executable=/usr/bin/chromium",
    "validate": "node scripts/validate.mjs",
    "render": "remotion render src/index.tsx SailRemotionDesign renders/sail-remotion-design.mp4 --browser-executable=/usr/bin/chromium --concurrency=4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
